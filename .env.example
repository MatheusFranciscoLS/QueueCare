# Copie para .env (que NUNCA vai para o Git) e troque os valores.
# Valores abaixo são fictícios, só para desenvolvimento local.
POSTGRES_DB=queuecare
POSTGRES_USER=queuecare
POSTGRES_PASSWORD=troque-esta-senha

# Usados pela API Spring Boot (backend/src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5432/queuecare
DB_USER=queuecare
DB_PASSWORD=troque-esta-senha

# Segredo do JWT (ADR 0003): Base64 de pelo menos 32 bytes aleatórios. Gere o SEU com:
#   openssl rand -base64 32
# Nunca reutilize o valor de exemplo abaixo, nunca versione o seu .env e use um segredo diferente em cada ambiente.
JWT_SECRET=troque-por-um-valor-gerado-com-openssl-rand-base64-32
# SOMENTE para o comando único que cria o primeiro ADMIN (ADR 0005). Deixe VAZIO aqui e nunca versione valores reais:
# informe-os só no terminal, na hora de executar o comando, e depois apague (unset).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origem(ns) do frontend aceitas pelo CORS (separe por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173
