# Copie para .env (que NUNCA vai para o Git) e troque os valores.
# Valores abaixo são fictícios, só para desenvolvimento local.
POSTGRES_DB=queuecare
POSTGRES_USER=queuecare
POSTGRES_PASSWORD=troque-esta-senha

# Usados pela API Spring Boot (backend/src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5432/queuecare
DB_USER=queuecare
DB_PASSWORD=troque-esta-senha
